---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import { SITE } from '../data/site';
---
<Base title="Contact" description="Contact ScadaBench for support, invoices, several licenses or protocol requests.">
  <PageHeader eyebrow="Contact" title="Talk to an engineer, not a bot." />
  <Prose>
    <p>Email <code>{SITE.supportEmail}</code>. We answer every message, usually within one working day.</p>
    <h2>Getting help faster</h2>
    <ul>
      <li>Tell us your ScadaBench version (Settings › About) and Windows version.</li>
      <li>For license questions include your license key or Machine ID (Settings › License). Never send passwords.</li>
      <li>For SCL problems describe the IED vendor and model. Share files only if you are allowed to; we never need a whole customer SCD to start.</li>
    </ul>
    <h2>Feature and protocol requests</h2>
    <p>IEC 60870-5-104 and other protocols are on the roadmap. Tell us what your projects need and we will prioritise it.</p>
  </Prose>
</Base>
