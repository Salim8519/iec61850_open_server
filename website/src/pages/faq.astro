---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqList from '../components/FaqList.astro';
import Closing from '../components/Closing.astro';
import { FAQ_GROUPS, faqSchema } from '../data/faqs';

const schema = faqSchema(FAQ_GROUPS.flatMap((group) => group.items));
---
<Base title="FAQ" schema={schema} description="Answers about ScadaBench: hardware, supported SCL files, SCADA connections, GOOSE, Sampled Values, offline use, licensing and refunds.">
  <PageHeader eyebrow="FAQ" title="Questions engineers ask first.">
    <nav class="jump" aria-label="FAQ topics">
      {FAQ_GROUPS.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
    </nav>
  </PageHeader>
  <section class="paper section">
    <div class="wrap groups">
      {FAQ_GROUPS.map((group) => (
        <section id={group.id} class="group" aria-labelledby={`${group.id}-title`}>
          <h2 id={`${group.id}-title`} class="eyebrow">{group.title}</h2>
          <FaqList items={group.items} />
        </section>
      ))}
      <p class="more">Still unsure? Write to us from the <a href="/contact/">contact page</a>; an engineer answers.</p>
    </div>
  </section>
  <Closing />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 10px; }
  .jump a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: .92rem; }
  .jump a:hover { border-color: var(--accent); }
  .groups { display: grid; gap: clamp(40px, 6vw, 64px); }
  .group { display: grid; gap: 8px; scroll-margin-top: 88px; }
  .more { color: var(--paper-muted); }
  .more a { color: var(--paper-ink); font-weight: 600; }
</style>
