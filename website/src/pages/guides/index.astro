---
// The list of search guides (data/howto); each card opens its own page.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Closing from '../../components/Closing.astro';
import { HOWTOS, guidePath } from '../../data/howto';
---
<Base title="IEC 61850 guides" description="Step-by-step IEC 61850 guides on Windows: simulate an IED from a CID or SCD file, test GOOSE without a test set and test SCADA without real IEDs.">
  <PageHeader eyebrow="Guides" title="IEC 61850 testing, step by step."
    lede="Short written guides for the jobs engineers search for most, each with real screenshots and a video of the app." />
  <section class="section">
    <div class="wrap cards">
      {HOWTOS.map((guide) => (
        <a class="card reveal" href={guidePath(guide)}>
          <span class="eyebrow">{guide.steps.length} steps</span>
          <h2>{guide.title}</h2>
          <p>{guide.description}</p>
          <span class="go mono">Read the guide →</span>
        </a>
      ))}
    </div>
  </section>
  <Closing />
</Base>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 20px; }
  .card { display: grid; gap: 14px; align-content: start; padding: 28px; border-radius: var(--radius);
    background: var(--panel); border: 1px solid var(--line); text-decoration: none; transition: border-color .2s ease; }
  .card:hover { border-color: var(--accent); }
  .card h2 { font-size: var(--step-1); letter-spacing: -0.02em; line-height: 1.2; }
  .card p { color: var(--muted); }
  .go { color: var(--accent); font-size: 0.85rem; }
</style>
