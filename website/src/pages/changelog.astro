---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import { SITE } from '../data/site';
// The one list of release notes, shared with the app's What's new window (change 0238).
import { releasesUpTo } from '../../../studio/frontend/src/copy/releaseNotes';

const releases = releasesUpTo(SITE.version);
---
<Base title="Changelog" description="What changed in each ScadaBench release.">
  <PageHeader eyebrow="Changelog" title="What's new." />
  <Prose>
    {releases.map(release => <>
      <h2>{release.version} · {release.title}</h2>
      <ul>{release.notes.map(note => <li>{note}</li>)}</ul>
    </>)}
  </Prose>
</Base>
