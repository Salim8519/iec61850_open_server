---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Closing from '../components/Closing.astro';
import { TUTORIALS, lengthOf, posterOf, totalSeconds, videoOf } from '../data/tutorials';
import { GUIDES } from '../data/guides';
const totalMinutes = Math.ceil(totalSeconds / 60);
---
<Base title="Tutorials" description="Learn IEC 61850 with ScadaBench: CID and SCD files, the single-line diagram, IED simulation, GOOSE, real devices, IED Explorer, the SCADA gateway, point panels, commands, tap changers and SNMP, and IEDs at their own addresses without a VM, in fourteen short narrated videos.">
  <PageHeader eyebrow="Tutorials" title={`Learn IEC 61850 in ${totalMinutes} minutes.`}
    lede="Fourteen short narrated lessons on the real app: IEC 61850, CID and SCD files, the SLD, simulation, GOOSE, real devices, IED Explorer, the SCADA gateway, GOOSE on the SLD, point panels, commands, SNMP devices and the lab network on this PC." />
  <section class="section">
    <div class="wrap list">
      {TUTORIALS.map((tutorial, index) => (
        <article id={tutorial.slug} class="lesson reveal">
          <div class="video">
            <video src={videoOf(tutorial)} poster={posterOf(tutorial)} controls preload="none" playsinline
              width="2560" height="1440" aria-label={`Video: ${tutorial.title}`}></video>
          </div>
          <div class="text">
            <span class="eyebrow">{String(index + 1).padStart(2, '0')} · {lengthOf(tutorial.seconds)}</span>
            <h2>{tutorial.title}</h2>
            <ol>{tutorial.steps.map((step) => <li>{step}</li>)}</ol>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="section" aria-labelledby="guides-title">
    <div class="wrap list">
      <h2 id="guides-title" class="guides-title">Picture guides</h2>
      {GUIDES.map((guide) => (
        <article id={guide.slug} class="guide reveal">
          <div class="text">
            <span class="eyebrow">Step by step</span>
            <h2>{guide.title}</h2>
            <p class="muted">{guide.intro}</p>
          </div>
          <ol class="steps">
            {guide.steps.map((step) => (
              <li>
                <p>{step.text}</p>
                {step.image && <img src={step.image.src} alt={step.image.alt} width={step.image.width}
                  height={step.image.height} loading="lazy" decoding="async" />}
              </li>
            ))}
          </ol>
          <p class="muted">{guide.note}</p>
        </article>
      ))}
    </div>
  </section>
  <Closing title="Try it with your own SCD." />
</Base>

<style>
  .list { display: grid; gap: 28px; }
  .lesson { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center;
    padding: 24px; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); }
  .video { aspect-ratio: 16 / 9; max-width: 100%; border-radius: var(--radius-small); overflow: hidden; background: var(--navy);
    border: 1px solid var(--line); }
  .video video { width: 100%; height: 100%; object-fit: cover; }
  .text { display: grid; gap: 12px; }
  .text h2 { font-size: var(--step-2); }
  ol { margin: 0; padding-left: 20px; display: grid; gap: 8px; color: var(--muted); }
  .guides-title { font-size: var(--step-3); }
  .guide { display: grid; gap: 20px; padding: 24px; border-radius: var(--radius); background: var(--panel);
    border: 1px solid var(--line); }
  .guide p { margin: 0; }
  .steps { gap: 24px; color: var(--ink); }
  .steps li { display: grid; gap: 12px; }
  .steps img { width: 100%; max-width: 900px; height: auto; border-radius: var(--radius-small); border: 1px solid var(--line); }
  .muted { color: var(--muted); }
  @media (max-width: 860px) { .lesson { grid-template-columns: 1fr; } }
</style>
