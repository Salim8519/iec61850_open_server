---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import TrustRow from '../components/TrustRow.astro';
import FaqList from '../components/FaqList.astro';
import BuiltBy from '../components/BuiltBy.astro';
import { SITE, buyUrl } from '../data/site';
import { FAQ_GROUPS, faqSchema } from '../data/faqs';

const buying = FAQ_GROUPS.find((group) => group.id === 'buying')!.items;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Product', name: `${SITE.name} lifetime license`,
    description: 'Lifetime license for one Windows PC, including offline activation.',
    offers: { '@type': 'Offer', price: SITE.price, priceCurrency: SITE.currency, availability: 'https://schema.org/InStock', url: buyUrl },
  },
  faqSchema(buying),
];
const included = [
  'Every feature: IED simulation, diagram, GOOSE, Sampled Values, real IEDs, health, test mode',
  'Unlimited projects and IEDs on that PC',
  'Offline activation for PCs without internet',
  'Works on one computer only; reinstalling Windows on the same computer is fine',
];
const after = [
  { title: 'Pay on PayPal', text: 'The Buy button opens a secure PayPal checkout. ScadaBench never sees your card.' },
  { title: 'Get your key', text: 'Your license key appears on screen right after payment and arrives by email.' },
  { title: 'Paste it in ScadaBench', text: 'Paste the key on the activation screen or in Settings › License.' },
];
---
<Base title="Pricing" schema={schema}
  description={`ScadaBench costs ${SITE.price} ${SITE.currency} once for a lifetime license on one PC. Try every feature free for ${SITE.trialDays} days. ${SITE.refundDays}-day refund before activation.`}>
  <PageHeader eyebrow="Pricing" title="Pay once. Use it for good."
    lede="No subscription and no feature tiers. Try everything first, then buy one license per PC." />
  <section class="paper section">
    <div class="wrap plans" data-cta-zone>
      <article class="plan">
        <h2>Free trial</h2>
        <p class="price"><span>$0</span> for {SITE.trialDays} days</p>
        <p class="muted">Every feature, no card. One trial per computer; needs internet once to start.</p>
        <a class="btn btn-ghost" href="/download/">Download free trial</a>
      </article>
      <article class="plan featured">
        <span class="badge mono">Most engineers choose this</span>
        <h2>Lifetime license</h2>
        <p class="price"><span>$<b data-price>{SITE.price}</b></span> once · {SITE.currency}</p>
        <ul>{included.map((item) => <li>{item}</li>)}</ul>
        <a class="btn btn-primary" href={buyUrl}>Buy with PayPal</a>
        <TrustRow />
      </article>
    </div>
    <div class="wrap after">
      <h2 class="eyebrow">What happens after you pay</h2>
      <ol>
        {after.map((step, index) => (
          <li class="reveal"><span class="num mono">{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></li>
        ))}
      </ol>
    </div>
    <div class="wrap questions">
      <h2 class="eyebrow">Buying questions</h2>
      <FaqList items={buying} />
      <p class="more">More answers on the <a href="/faq/">FAQ page</a>. Full terms, including refunds, in the
        <a href="/legal/eula/#refunds">license agreement</a>.</p>
    </div>
  </section>
  <BuiltBy />
</Base>

<style>
  .plans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; max-width: 920px; }
  .plan { position: relative; display: grid; gap: 16px; align-content: start; padding: clamp(24px, 5vw, 36px);
    border-radius: var(--radius); background: #fff; border: 1px solid var(--paper-line); }
  .plan.featured { background: var(--paper-ink); color: var(--ink); border-color: var(--paper-ink); }
  .plan.featured .muted, .plan.featured li { color: var(--muted); }
  .plan h2 { font-size: var(--step-1); letter-spacing: -0.02em; }
  .price { font-size: 1rem; color: var(--paper-muted); }
  .featured .price { color: var(--muted); }
  .price span { font-size: 3rem; font-weight: 650; letter-spacing: -0.04em; color: inherit; margin-right: 6px; }
  .plan.featured .price span { color: var(--ink); }
  .plan:not(.featured) .price span { color: var(--paper-ink); }
  .price b { font-weight: inherit; }
  .plan ul { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
  .badge { position: absolute; top: -12px; right: 24px; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    background: var(--accent); color: var(--accent-ink); padding: 6px 10px; border-radius: 999px; }
  .plan .btn { justify-self: start; }
  .after, .questions { display: grid; gap: 20px; margin-top: clamp(56px, 8vw, 88px); }
  .after ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .after li { display: grid; gap: 8px; align-content: start; padding: 24px; border-radius: var(--radius); background: #fff;
    border: 1px solid var(--paper-line); }
  .num { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--paper-ink);
    color: var(--accent); font-size: .9rem; }
  .after h3 { font-size: 1.15rem; letter-spacing: -0.02em; }
  .after p, .more { color: var(--paper-muted); }
  .more a { color: var(--paper-ink); font-weight: 600; }
  @media (max-width: 760px) {
    .plans, .after ol { grid-template-columns: 1fr; }
    .plan .btn { justify-self: stretch; }
    .badge { right: 16px; }
  }
</style>
