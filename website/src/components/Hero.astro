---
import HeroPoster from './HeroPoster.astro';
import { SITE, buyUrl } from '../data/site';
---
<section class="hero">
  <div class="wrap copy">
    <span class="eyebrow">IEC 61850 · MMS · GOOSE · Sampled Values</span>
    <h1>Your substation,<br /><span>live on your desk.</span></h1>
    <p class="lede">ScadaBench turns CID, ICD and SCD files into running IEC 61850 IEDs. Test your SCADA,
      gateways and protection logic weeks before site acceptance, without a single relay on the bench.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/download/">Download free {SITE.trialDays}-day trial</a>
      <a class="btn btn-ghost" href={buyUrl}>Buy lifetime · $<span data-price>{SITE.price}</span></a>
    </div>
  </div>
  <div class="wrap">
    <div class="stage" data-hero-stage>
      <div class="poster-layer"><HeroPoster /></div>
      <canvas class="scene" data-hero-canvas aria-hidden="true"></canvas>
    </div>
    <ul class="chips" aria-label="Protocol facts">
        <li><b>MMS</b> server on port 102</li>
        <li><b>GOOSE</b> publish and listen</li>
        <li><b>SV</b> 9-2 stream supervision</li>
        <li><b>SCL</b> 2003 · 2007B · 2007B4</li>
    </ul>
  </div>
</section>

<script>
  // The 3D scene loads only after the page is shown, on capable desktops, never on
  // reduced motion or data saver. Everyone else keeps the SVG poster.
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const capable = !matchMedia('(prefers-reduced-motion: reduce)').matches && !connection?.saveData
    && (navigator.hardwareConcurrency || 4) >= 4 && window.innerWidth >= 720
    && !!document.createElement('canvas').getContext('webgl2');
  function load() {
    if (!stage || !canvas || !capable) return;
    import('../scripts/hero3d').then(({ startHero }) => {
      startHero(canvas, () => stage.classList.add('is-3d'));
    }).catch(() => {});
  }
  const idle = (window as Window & { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
  const later = () => (idle ? idle(load) : setTimeout(load, 300));
  if (document.readyState === 'complete') later(); else addEventListener('load', later, { once: true });
</script>

<style>
  .hero { position: relative; padding-block: clamp(56px, 9vw, 120px) clamp(48px, 7vw, 96px); overflow: hidden;
    background: radial-gradient(1200px 520px at 50% -10%, #12305a 0%, transparent 65%), var(--night); }
  .copy { display: grid; justify-items: center; text-align: center; gap: 22px; margin-bottom: clamp(36px, 6vw, 64px); }
  h1 { font-size: var(--step-4); font-weight: 680; letter-spacing: -0.045em; }
  h1 span { background: linear-gradient(90deg, #eaf0f8 0%, #2be4b0 55%, #38bdf8 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 8px; }
  .stage { position: relative; aspect-ratio: 12 / 5; max-width: 100%; border-radius: 28px; overflow: hidden;
    border: 1px solid rgb(255 255 255 / 7%); background: linear-gradient(180deg, #0b1528 0%, #070d1a 100%);
    box-shadow: var(--shadow), inset 0 1px 0 rgb(255 255 255 / 6%); }
  .poster-layer, .scene { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster-layer { padding: 3% 4%; transition: opacity 1.2s ease; }
  .scene { opacity: 0; transition: opacity 1.4s ease; }
  .stage.is-3d .scene { opacity: 1; }
  .stage.is-3d .poster-layer { opacity: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin: 0; padding: 22px 0 0; list-style: none; }
  .chips li { font: 500 0.78rem/1 var(--mono); color: var(--muted); padding: 8px 12px; border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 9%); background: rgb(10 18 34 / 70%); backdrop-filter: blur(8px); }
  .chips b { color: var(--ink); font-weight: 600; margin-right: 4px; }
  @media (max-width: 720px) {
    .stage { aspect-ratio: 6 / 5; border-radius: 20px; }
  }
</style>
