---
// Phone buy bar: once the first screen is scrolled away, "Free trial" and "Buy" stay one tap
// away. It hides again wherever the page already shows its own buying buttons.
import { SITE, buyUrl } from '../data/site';
---
<div class="cta-bar" data-cta-bar hidden>
  <a class="btn btn-primary" href="/download/">Free {SITE.trialDays}-day trial</a>
  <a class="btn btn-ghost" href={buyUrl}><span>Buy · $<span data-price>{SITE.price}</span></span></a>
</div>

<script>
  import { startCtaBar } from '../scripts/stickyCta';
  startCtaBar();
</script>

<style>
  .cta-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid;
    grid-template-columns: 1.3fr 1fr; gap: 10px; padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom, 0px));
    background: rgb(7 13 26 / 96%); border-top: 1px solid var(--line); transform: translateY(110%);
    transition: transform .25s ease; }
  .cta-bar[hidden] { display: none; }
  .cta-bar.shown { transform: none; }
  .cta-bar .btn { min-height: 48px; padding: 0 12px; font-size: .95rem; }
  @media (min-width: 760px) { .cta-bar { display: none !important; } }
  @media (prefers-reduced-motion: reduce) { .cta-bar { transition: none; } }
</style>
