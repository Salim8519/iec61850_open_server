---
// Readable long-form text (legal, changelog, contact) on the light paper surface.
---
<section class="paper prose-section">
  <div class="wrap"><div class="prose"><slot /></div></div>
</section>

<style>
  .prose-section { padding-block: clamp(48px, 7vw, 96px); }
  .prose { max-width: 70ch; display: grid; gap: 16px; color: var(--paper-ink); }
  .prose :global(h2) { font-size: var(--step-2); margin-top: 24px; }
  .prose :global(h3) { font-size: var(--step-1); margin-top: 12px; letter-spacing: -0.02em; }
  .prose :global(p), .prose :global(li) { color: var(--paper-muted); line-height: 1.7; }
  .prose :global(ul) { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
  .prose :global(a) { color: var(--paper-ink); }
  .prose :global(code) { font-family: var(--mono); font-size: .9em; background: var(--paper-2); padding: 2px 6px; border-radius: 6px; }
  .prose :global(.note) { padding: 14px 18px; border-radius: var(--radius-small); background: var(--paper-2); color: var(--paper-ink); }
</style>
