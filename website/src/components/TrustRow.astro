---
// Short buying assurances shown next to every buy button. Each one is true today:
// PayPal checkout, key on screen and by email (ADR-0047/0072), the refund policy in the EULA.
import { SITE } from '../data/site';
interface Props { tone?: 'dark' | 'paper'; }
const { tone = 'dark' } = Astro.props;
const items = [
  { icon: 'M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Z', text: 'Secure checkout on PayPal' },
  { icon: 'M4 6h16v12H4zM4 7l8 6 8-6', text: 'Key on screen and by email' },
  { icon: 'M4 12a8 8 0 1 0 3-6.2M4 4v4h4', text: `${SITE.refundDays}-day refund policy`, href: '/legal/eula/#refunds' },
  { icon: 'M5 12.5 10 17l9-10', text: 'Works offline after activation' },
];
---
<ul class:list={['trust', tone]} aria-label="Buying assurances">
  {items.map((item) => (
    <li>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={item.icon} /></svg>
      {item.href ? <a href={item.href}>{item.text}</a> : <span>{item.text}</span>}
    </li>
  ))}
</ul>

<style>
  .trust { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: .9rem; }
  .trust li { display: flex; align-items: center; gap: 8px; }
  svg { flex-shrink: 0; fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .dark { color: var(--muted); }
  .paper { color: var(--paper-muted); }
  .paper svg { stroke: var(--accent-on-paper); }
  a { color: inherit; text-underline-offset: 3px; }
</style>
