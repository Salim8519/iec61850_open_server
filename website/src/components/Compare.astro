---
// Why buy: a hardware test bench next to ScadaBench. The ScadaBench column states only what
// the product evidence shows; the hardware column stays general (no competitor names or prices).
import { SITE } from '../data/site';
const rows = [
  { topic: 'What you need', bench: 'Relays, merging units, a switch and often a test set for every bay type.',
    ours: 'One Windows PC. The IEDs come from your CID, ICD or SCD files.' },
  { topic: 'When testing can start', bench: 'Only once the hardware has arrived and been wired up.',
    ours: 'The day you have the SCD. SCADA and gateways connect on port 102 like on site.' },
  { topic: 'Risk to real devices', bench: 'Tests run on real protection relays and their settings.',
    ours: 'Simulated IEDs. Real relays are only ever read, never operated or written.' },
  { topic: 'Setup', bench: 'Rack space, cabling, firmware versions, IP plans.',
    ours: 'One installer. No Docker, Python or Node. Works offline after activation.' },
  { topic: 'Cost', bench: 'Hardware, shipping and bench time for each project.',
    ours: `One lifetime license per PC, paid once. No subscription. Free ${SITE.trialDays}-day trial first.` },
];
---
<section class="compare paper section lazy-render" aria-labelledby="compare-title">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Why engineers switch</span>
      <h2 id="compare-title">A hardware bench, or a bench on your laptop.</h2>
      <p class="lede">Keep the real relays for site acceptance. Do everything before it on your desk.</p>
    </div>
    <div class="table reveal" role="table" aria-label="Hardware test bench compared with ScadaBench">
      <div class="row head" role="row">
        <span role="columnheader"><span class="sr">Topic</span></span>
        <span role="columnheader">Hardware test bench</span>
        <span role="columnheader" class="ours-head">ScadaBench</span>
      </div>
      {rows.map((row) => (
        <div class="row" role="row">
          <span class="topic" role="rowheader">{row.topic}</span>
          <span class="bench" role="cell"><b class="label">Hardware bench</b>{row.bench}</span>
          <span class="ours" role="cell"><b class="label">ScadaBench</b>{row.ours}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .table { display: grid; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--paper-line); background: #fff; }
  .row { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr) minmax(0, 1fr); }
  .row + .row { border-top: 1px solid var(--paper-line); }
  .row > span { padding: 20px 22px; }
  .head { background: var(--paper-2); font: 500 .78rem/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase;
    color: var(--paper-muted); }
  .head .ours-head { color: var(--accent-on-paper); }
  .topic { font-weight: 650; letter-spacing: -0.01em; }
  .bench { color: var(--paper-muted); }
  .ours { background: rgb(43 228 176 / 8%); color: var(--paper-ink); border-left: 3px solid var(--accent); }
  .label, .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 760px) {
    .head { display: none; }
    .row { grid-template-columns: 1fr; }
    .row > span { padding: 12px 18px; }
    .topic { padding-top: 18px !important; font-size: 1.1rem; }
    .label { position: static; width: auto; height: auto; clip-path: none; display: block; margin-bottom: 4px;
      font: 500 .72rem/1.2 var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--paper-muted); }
    .ours .label { color: var(--accent-on-paper); }
    .ours { border-left: 0; border-top: 3px solid var(--accent); padding-bottom: 18px !important; }
  }
</style>
