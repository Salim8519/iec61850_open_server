---
// Fold-out questions on the light paper surface. Works without JavaScript (<details>).
import type { Faq } from '../data/faqs';
interface Props { items: Faq[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="item">
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { max-width: 860px; display: grid; }
  .item { border-bottom: 1px solid var(--paper-line); }
  summary { cursor: pointer; list-style: none; padding: 20px 44px 20px 0; font-size: var(--step-1); font-weight: 600;
    letter-spacing: -0.015em; position: relative; line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 50%; translate: 0 -50%; font: 400 1.6rem/1 var(--mono);
    color: var(--accent-on-paper); transition: rotate .25s ease; }
  details[open] summary::after { rotate: 45deg; }
  .item p { padding: 0 0 22px; color: var(--paper-muted); max-width: 66ch; }
  @media (max-width: 600px) { summary { font-size: 1.08rem; } }
</style>
