---
import { NAV, SITE } from '../data/site';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <img src="/favicon.svg" alt="" width="30" height="30" />
      <span>Scada<b>Bench</b></span>
    </a>
    <nav aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary cta" href="/download/">Free trial</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50;
    background: rgb(7 13 26 / 72%); backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px); border-bottom: 1px solid rgb(255 255 255 / 6%);
  }
  .bar { display: flex; align-items: center; gap: 28px; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 650;
    font-size: 1.1rem; letter-spacing: -0.02em; }
  .brand b { color: var(--accent); font-weight: 650; }
  nav { display: flex; gap: 26px; margin-left: auto; }
  nav a { text-decoration: none; color: var(--muted); font-size: 0.94rem; transition: color .2s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--ink); }
  .cta { min-height: 38px; padding: 0 18px; font-size: 0.92rem; }
  @media (max-width: 760px) {
    nav { display: none; }
    .cta { margin-left: auto; }
  }
</style>
