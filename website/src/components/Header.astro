---
// Site header: brand, the full navigation on wide screens and the two buying actions.
// Below 1080px the links move into the phone menu so nothing is ever hidden.
import MobileMenu from './MobileMenu.astro';
import { NAV, SITE, buyUrl, isCurrent } from '../data/site';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <img src="/favicon.svg" alt="" width="30" height="30" />
      <span>Scada<b>Bench</b></span>
    </a>
    <nav class="links" aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href, current) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="actions">
      <a class="btn btn-ghost buy" href={buyUrl}><span>Buy · $<span data-price>{SITE.price}</span></span></a>
      <a class="btn btn-primary trial" href="/download/">Free trial</a>
    </div>
    <MobileMenu />
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; padding-top: env(safe-area-inset-top, 0px);
    background: rgb(7 13 26 / 96%); border-bottom: 1px solid rgb(255 255 255 / 6%);
  }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 650;
    font-size: 1.1rem; letter-spacing: -0.02em; flex-shrink: 0; }
  .brand b { color: var(--accent); font-weight: 650; }
  .links { display: flex; gap: 22px; margin-left: auto; }
  .links a { text-decoration: none; color: var(--muted); font-size: 0.94rem; transition: color .2s; padding-block: 8px;
    border-bottom: 2px solid transparent; }
  .links a:hover { color: var(--ink); }
  .links a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }
  .actions { display: flex; gap: 10px; }
  .actions .btn { min-height: 40px; padding: 0 18px; font-size: 0.92rem; }
  /* The blur only runs where the phone menu is hidden: a backdrop filter would trap the
     fixed menu sheet inside the header, and it costs frames on phone GPUs while scrolling. */
  @media (min-width: 1080px) {
    .site-header { background: rgb(7 13 26 / 72%); backdrop-filter: saturate(160%) blur(16px);
      -webkit-backdrop-filter: saturate(160%) blur(16px); }
  }
  @media (max-width: 1079px) {
    .links, .buy { display: none; }
    .actions { margin-left: auto; }
  }
  @media (max-width: 480px) {
    .bar { gap: 10px; }
    .brand { font-size: 1rem; gap: 8px; }
    .brand img { width: 26px; height: 26px; }
    .actions .btn { padding: 0 14px; }
  }
</style>
