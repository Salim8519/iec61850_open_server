---
// One manual page: the page header, the page list beside the text, the tutorial video when the
// page names one, the text itself, and previous/next links. Used by every page under /docs/.
import Base from './Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsPager from '../components/docs/DocsPager.astro';
import { sectionOf, type DocEntry } from '../data/docs';
import { TUTORIALS, lengthOf, posterOf, videoOf } from '../data/tutorials';
import '../styles/docs.css';

interface Props { entry: DocEntry; pages: DocEntry[]; }
const { entry, pages } = Astro.props;
const index = pages.findIndex((page) => page.id === entry.id);
const prev = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined;
const section = sectionOf(entry.data.section);
const tutorial = entry.data.video ? TUTORIALS.find((item) => item.slug === entry.data.video) : undefined;
if (entry.data.video && !tutorial) throw new Error(`Unknown tutorial "${entry.data.video}" in ${entry.id}`);
---
<Base title={entry.data.title} description={entry.data.description}>
  <PageHeader eyebrow={section?.title ?? 'Manual'} title={entry.data.title} lede={entry.data.description} />
  <Prose>
    <Fragment slot="aside"><DocsSidebar pages={pages} current={entry.id} /></Fragment>
    {tutorial && (
      <figure class="doc-video">
        <video src={videoOf(tutorial)} poster={posterOf(tutorial)} controls preload="none" playsinline
          width="2560" height="1440" aria-label={`Video: ${tutorial.title}`}></video>
        <figcaption>Video: {tutorial.title} · {lengthOf(tutorial.seconds)}. More in <a href={`/tutorials/#${tutorial.slug}`}>Tutorials</a>.</figcaption>
      </figure>
    )}
    <div class="doc-body"><slot /></div>
    <DocsPager prev={prev} next={next} />
  </Prose>
</Base>
